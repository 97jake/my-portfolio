<canvas id="snowfall" aria-hidden="true"></canvas>

<style>
	#snowfall {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		z-index: 1;
	}
</style>

<script>
	const canvas = document.getElementById('snowfall') as HTMLCanvasElement | null;
	const ctx = canvas?.getContext('2d') ?? null;
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (canvas && ctx && !prefersReducedMotion) {
		const SNOW_COLOR = '96, 115, 159';

		// Depth layers: far flakes are small, faint, slow, and barely pushed by wind;
		// near flakes are bigger, brighter, faster, and swing more with each gust.
		// "softness" bakes a blur-like falloff into each layer's sprite so we never
		// need the very expensive ctx.filter blur at draw time.
		const LAYERS = [
			{
				weight: 0.5,
				minRadius: 0.5,
				maxRadius: 1.2,
				minSpeed: 0.65,
				maxSpeed: 1.05,
				minOpacity: 0.15,
				maxOpacity: 0.35,
				wobbleAmp: 0.2,
				windFactor: 0.3,
				softness: 0.25,
			},
			{
				weight: 0.32,
				minRadius: 1.2,
				maxRadius: 2.1,
				minSpeed: 1.05,
				maxSpeed: 1.8,
				minOpacity: 0.35,
				maxOpacity: 0.6,
				wobbleAmp: 0.5,
				windFactor: 0.65,
				softness: 0.45,
			},
			{
				weight: 0.18,
				minRadius: 2.1,
				maxRadius: 3.6,
				minSpeed: 1.8,
				maxSpeed: 2.8,
				minOpacity: 0.55,
				maxOpacity: 0.9,
				wobbleAmp: 0.35,
				windFactor: 1,
				softness: 0.65,
			},
		];

		// Pre-render each layer's flake as a small offscreen sprite once. Drawing
		// it with drawImage per frame is hardware-accelerated and avoids the cost
		// of allocating a CanvasGradient and filling an arc for every flake, every frame.
		const SPRITE_PADDING = 1.6;
		const sprites = LAYERS.map((layer) => {
			const spriteRadius = layer.maxRadius * SPRITE_PADDING;
			const dim = Math.ceil(spriteRadius * 2);
			const spriteCanvas = document.createElement('canvas');
			spriteCanvas.width = dim;
			spriteCanvas.height = dim;
			const sctx = spriteCanvas.getContext('2d')!;
			const gradient = sctx.createRadialGradient(
				dim / 2,
				dim / 2,
				0,
				dim / 2,
				dim / 2,
				spriteRadius,
			);
			gradient.addColorStop(0, `rgba(${SNOW_COLOR}, 1)`);
			gradient.addColorStop(layer.softness, `rgba(${SNOW_COLOR}, 0.5)`);
			gradient.addColorStop(1, `rgba(${SNOW_COLOR}, 0)`);
			sctx.fillStyle = gradient;
			sctx.beginPath();
			sctx.arc(dim / 2, dim / 2, spriteRadius, 0, Math.PI * 2);
			sctx.fill();
			return { canvas: spriteCanvas, nominalRadius: layer.maxRadius };
		});

		type Flake = {
			x: number;
			y: number;
			radius: number;
			speed: number;
			opacity: number;
			wobble: number;
			wobbleSpeed: number;
		};

		let width = window.innerWidth;
		let height = window.innerHeight;
		const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
		const flakesByLayer: Flake[][] = LAYERS.map(() => []);
		let animationFrame = 0;
		let visible = !document.hidden;
		let windTime = Math.random() * 1000;

		function createFlake(layerIndex: number, startAbove: boolean): Flake {
			const layer = LAYERS[layerIndex];
			return {
				x: Math.random() * width,
				y: startAbove ? -10 : Math.random() * height,
				radius: layer.minRadius + Math.random() * (layer.maxRadius - layer.minRadius),
				speed: layer.minSpeed + Math.random() * (layer.maxSpeed - layer.minSpeed),
				opacity: layer.minOpacity + Math.random() * (layer.maxOpacity - layer.minOpacity),
				wobble: Math.random() * Math.PI * 2,
				wobbleSpeed: Math.random() * 0.02 + 0.008,
			};
		}

		function totalFlakeCount() {
			return Math.min(220, Math.round((width * height) / 7500));
		}

		function resize() {
			width = window.innerWidth;
			height = window.innerHeight;
			canvas!.width = width * dpr;
			canvas!.height = height * dpr;
			canvas!.style.width = `${width}px`;
			canvas!.style.height = `${height}px`;
			ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

			const total = totalFlakeCount();
			for (let li = 0; li < LAYERS.length; li++) {
				const target = Math.round(total * LAYERS[li].weight);
				const bucket = flakesByLayer[li];
				if (bucket.length < target) {
					for (let i = bucket.length; i < target; i++) bucket.push(createFlake(li, false));
				} else {
					bucket.length = target;
				}
			}
		}

		function tick() {
			ctx!.clearRect(0, 0, width, height);

			// A slowly drifting compound sine wave acts as a shared gust so flakes
			// move together like they're riding the same air, instead of each
			// wandering independently (which is what reads as "dust" not "snow").
			windTime += 0.004;
			const wind = Math.sin(windTime) * 0.5 + Math.sin(windTime * 2.7 + 1.3) * 0.2;

			for (let li = 0; li < LAYERS.length; li++) {
				const layer = LAYERS[li];
				const sprite = sprites[li];

				for (const flake of flakesByLayer[li]) {
					flake.wobble += flake.wobbleSpeed;
					flake.x += wind * layer.windFactor + Math.sin(flake.wobble) * layer.wobbleAmp;
					flake.y += flake.speed;

					if (flake.y - flake.radius > height) Object.assign(flake, createFlake(li, true));
					if (flake.x > width + 10) flake.x = -10;
					if (flake.x < -10) flake.x = width + 10;

					const scale = flake.radius / sprite.nominalRadius;
					const size = sprite.canvas.width * scale;
					ctx!.globalAlpha = flake.opacity;
					ctx!.drawImage(sprite.canvas, flake.x - size / 2, flake.y - size / 2, size, size);
				}
			}
			ctx!.globalAlpha = 1;

			if (visible) animationFrame = requestAnimationFrame(tick);
		}

		resize();
		animationFrame = requestAnimationFrame(tick);

		window.addEventListener('resize', resize);

		document.addEventListener('visibilitychange', () => {
			visible = !document.hidden;
			if (visible) {
				animationFrame = requestAnimationFrame(tick);
			} else {
				cancelAnimationFrame(animationFrame);
			}
		});
	}
</script>

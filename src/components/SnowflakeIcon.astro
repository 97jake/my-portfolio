---
interface Props {
	size?: number;
	class?: string;
}

const { size = 20, class: className } = Astro.props;
---

<svg
	class={className}
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.6"
	stroke-linecap="round"
	aria-hidden="true"
>
	<g>
		<line x1="12" y1="2" x2="12" y2="22"></line>
		<line x1="12" y1="6.5" x2="9" y2="4.5"></line>
		<line x1="12" y1="6.5" x2="15" y2="4.5"></line>
		<line x1="12" y1="17.5" x2="9" y2="19.5"></line>
		<line x1="12" y1="17.5" x2="15" y2="19.5"></line>
	</g>
	<g transform="rotate(60 12 12)">
		<line x1="12" y1="2" x2="12" y2="22"></line>
		<line x1="12" y1="6.5" x2="9" y2="4.5"></line>
		<line x1="12" y1="6.5" x2="15" y2="4.5"></line>
		<line x1="12" y1="17.5" x2="9" y2="19.5"></line>
		<line x1="12" y1="17.5" x2="15" y2="19.5"></line>
	</g>
	<g transform="rotate(120 12 12)">
		<line x1="12" y1="2" x2="12" y2="22"></line>
		<line x1="12" y1="6.5" x2="9" y2="4.5"></line>
		<line x1="12" y1="6.5" x2="15" y2="4.5"></line>
		<line x1="12" y1="17.5" x2="9" y2="19.5"></line>
		<line x1="12" y1="17.5" x2="15" y2="19.5"></line>
	</g>
</svg>

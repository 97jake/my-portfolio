---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<p class="copyright">&copy; {today.getFullYear()} Jake Snow</p>
		<div class="footer-links">
			<a href="mailto:97jake@gmail.com">97jake@gmail.com</a>
			<a href="https://github.com/97jake" target="_blank">github.com/97jake</a>
		</div>
	</div>
</footer>
<style>
	footer {
		border-top: 1px solid var(--line);
	}
	.footer-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 12px;
		max-width: 1080px;
		margin: 0 auto;
		padding: 22px 28px 26px;
	}
	.copyright {
		margin: 0;
		font-size: 14px;
		color: rgb(var(--ink-2));
	}
	.footer-links {
		display: flex;
		gap: 24px;
		flex-wrap: wrap;
	}
	.footer-links a {
		color: rgb(var(--ink-2));
		font-size: 14px;
		text-decoration: none;
		min-height: 32px;
		display: inline-flex;
		align-items: center;
	}
	.footer-links a:hover {
		color: rgb(var(--ink));
	}
	@media (max-width: 600px) {
		.footer-inner {
			flex-direction: column;
			align-items: flex-start;
			gap: 4px;
		}
	}
</style>

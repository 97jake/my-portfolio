---
interface Props {
	text: string;
}

const { text } = Astro.props;
---

<div class="output-cell">
	<span class="output-label">Output</span>
	<pre><code>{text}</code></pre>
</div>
<style>
	.output-cell {
		margin: 0 0 1.5em;
		padding: 1em 1.2em;
		background: rgb(var(--gray-light));
		border: none;
		border-left: 3px solid var(--accent-teal);
		border-radius: 0 8px 8px 0;
		box-shadow: none;
		font-size: 0.85em;
	}
	.output-label {
		display: block;
		margin-bottom: 0.4em;
		font-size: 0.7em;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: rgb(var(--gray));
	}
	.output-cell pre {
		margin: 0;
		padding: 0;
		background: transparent;
		border: none;
		box-shadow: none;
		overflow-x: auto;
	}
	.output-cell code {
		all: unset;
		display: block;
		font-family: monospace;
		white-space: pre-wrap;
	}
</style>

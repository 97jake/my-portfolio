---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { Image } from 'astro:assets';
import AboutHeroImage from '../assets/photo_of_me.png';

const pageDescription = 'A bit about who I am outside of work.';

const hobbies = [
	{
		title: 'Birding',
		icon: '🐦',
		before:
			"I've been an avid birder since 2021 and love talking all things avian! If you can't join me on an outing, follow along on my ",
		link: 'https://ebird.org/profile/Mzc4NDg0Nw',
		linkText: 'eBird profile',
		after: '.',
	},
	{
		title: 'Reading',
		icon: '📚',
		before:
			"Whether it's a day on the beach, a rainy day, or a sunny afternoon, there's always a reason to open up a good book! Check out what I'm reading on ",
		link: 'https://www.goodreads.com/user/show/180917352-jake-snow',
		linkText: 'Goodreads',
		after: '.',
	},
	{
		title: 'Movies',
		icon: '🎬',
		before: "I'm an AMC A-Lister, need I say more?",
	},
	{
		title: 'Volunteering',
		icon: '🤝',
		before:
			"I believe making a difference starts in your neighborhood, which is why I've volunteered at Arlington Food Assistance Center for the past year and a half delivering groceries to those that can't travel to the Center themselves. If you're in the Arlington area, ask me about other volunteering opportunities!",
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description={pageDescription} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-image">
					<Image src={AboutHeroImage} alt="Jake Snow" width={320} height={320} />
				</div>
				<div class="hero-text">
					<p class="eyebrow">About Me</p>
					<h1>Jake Snow</h1>
					<p class="tagline">Software developer — website redesign &amp; development</p>
					<p class="lede">
						Hello, and welcome to my personal website! I want to build a relationship of trust
						with the people I work with, and the best way of developing trust is by truly getting
						to know someone, and that's something that I can't fit on a resume! So let me tell you
						a little about me...
					</p>
				</div>
			</section>

			<section class="hobbies">
				<div class="hobby-cards">
					{
						hobbies.map((hobby) => (
							<div class="hobby-card">
								<div class="hobby-icon">{hobby.icon}</div>
								<div class="hobby-body">
									<h3>{hobby.title}</h3>
									<p>{hobby.before}{hobby.link && (<a href={hobby.link} target="_blank" rel="noopener noreferrer">{hobby.linkText}</a>)}{hobby.after}</p>
								</div>
							</div>
						))
					}
				</div>
			</section>

			<section id="contact" class="cta-band">
				<h2>Have a project in mind?</h2>
				<p>Tell me what you're working on — I'd love to hear about it.</p>
				<a class="button-inverse" href="mailto:97jake@gmail.com?subject=Consulting%20Inquiry"
					>Email me</a
				>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
		max-width: 1080px;
		padding-top: 2em;
	}
	section {
		margin-bottom: 4em;
	}
	.eyebrow {
		margin: 0 0 14px;
		font-size: 12px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent);
		font-weight: 700;
	}
	.hero {
		display: flex;
		align-items: center;
		gap: 3em;
		padding: 2em 1em 0;
	}
	.hero-text {
		flex: 1 1 55%;
	}
	.hero-text h1 {
		margin: 0 0 10px;
		font-weight: 700;
		font-size: clamp(32px, 6vw, 52px);
		line-height: 1.04;
		letter-spacing: -0.025em;
		color: rgb(var(--ink));
	}
	.hero-text .tagline {
		font-weight: 700;
		font-size: 16px;
		color: rgb(var(--ink));
		margin: 0 0 16px;
	}
	.hero-text .lede {
		font-size: 15px;
		line-height: 1.6;
		color: rgb(var(--ink-2));
		max-width: 62ch;
	}
	.hero-image {
		flex: 0 0 auto;
		max-width: 240px;
	}
	.hero-image :global(img) {
		width: 100%;
		height: auto;
		border-radius: 16px;
		transform: rotate(2deg);
		box-shadow: var(--box-shadow);
	}
	.hobby-cards {
		display: flex;
		flex-direction: column;
		gap: 1.25em;
		max-width: 560px;
		margin: 0 auto;
	}
	.hobby-card {
		display: flex;
		gap: 1em;
		align-items: flex-start;
		background: var(--card);
		border: 1px solid var(--line);
		border-radius: 14px;
		padding: 1.5em;
	}
	.hobby-icon {
		flex: 0 0 auto;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.75em;
		height: 2.75em;
		border-radius: 50%;
		font-size: 1.4em;
		background: var(--tint-blue);
	}
	.hobby-body h3 {
		font-size: 1.05em;
		margin-bottom: 0.4em;
		color: rgb(var(--ink));
	}
	.hobby-body p {
		margin-bottom: 0;
		font-size: 0.95em;
		color: rgb(var(--ink-2));
	}
	.cta-band {
		background: rgb(var(--ink));
		color: #fbf8f3;
		text-align: center;
		border-radius: 16px;
		padding: 3em 2em;
		margin-bottom: 1em;
	}
	.cta-band h2 {
		color: #fbf8f3;
		margin-bottom: 0.5em;
	}
	.cta-band p {
		font-size: 1.05em;
		color: rgba(251, 248, 243, 0.75);
		margin-bottom: 1.5em;
	}
	.button-inverse {
		display: inline-flex;
		align-items: center;
		min-height: 46px;
		padding: 0 22px;
		border-radius: 999px;
		font-size: 15px;
		font-weight: 700;
		text-decoration: none;
		background: #fbf8f3;
		color: rgb(var(--ink));
	}
	.button-inverse:hover {
		background: var(--accent);
		color: #fbf8f3;
	}
	@media (max-width: 720px) {
		.hero {
			flex-direction: column;
			gap: 1.5em;
			padding: 1em 1em 0;
		}
		.hero-image {
			max-width: 200px;
		}
		section {
			margin-bottom: 3em;
		}
		.cta-band {
			padding: 2.5em 1.5em;
		}
	}
</style>

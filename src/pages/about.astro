---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { Image } from 'astro:assets';
import AboutHeroImage from '../assets/photo_of_me.png';

const pageDescription = 'A bit about who I am outside of work.';

const hobbies = [
	{
		title: 'Birding',
		icon: '🐦',
		before:
			"I've been an avid birder since 2021 and love talking all things avian! If you can't join me on an outing, follow along on my ",
		link: 'https://ebird.org/profile/Mzc4NDg0Nw',
		linkText: 'eBird profile',
		after: '.',
	},
	{
		title: 'Reading',
		icon: '📚',
		before:
			"Whether it's a day on the beach, a rainy day, or a sunny afternoon, there's always a reason to open up a good book! Check out what I'm reading on ",
		link: 'https://www.goodreads.com/user/show/180917352-jake-snow',
		linkText: 'Goodreads',
		after: '.',
	},
	{
		title: 'Movies',
		icon: '🎬',
		before: "I'm an AMC A-Lister, need I say more?",
	},
	{
		title: 'Volunteering',
		icon: '🤝',
		before:
			"I believe making a difference starts in your neighborhood, which is why I've volunteered at Arlington Food Assistance Center for the past year and a half delivering groceries to those that can't travel to the Center themselves. If you're in the Arlington area, ask me about other volunteering opportunities!",
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description={pageDescription} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-image">
					<Image src={AboutHeroImage} alt="Jake Snow" width={320} height={320} />
				</div>
				<div class="hero-text">
					<p class="eyebrow">About Me</p>
					<h1>Jake Snow</h1>
					<p class="tagline">AI Engineering Consultant — Building Pipelines that Scale</p>
					<p class="lede">
						Hello, and welcome to my personal website! I want to build a relationship of trust
						with the people I work with, and the best way of developing trust is by truly getting
						to know someone, and that's something that I can't fit on a resume! So let me tell you
						a little about me...
					</p>
				</div>
			</section>

			<section class="hobbies">
				<div class="hobby-cards">
					{
						hobbies.map((hobby) => (
							<div class="hobby-card">
								<div class="hobby-icon">{hobby.icon}</div>
								<div class="hobby-body">
									<h3>{hobby.title}</h3>
									<p>{hobby.before}{hobby.link && (<a href={hobby.link} target="_blank" rel="noopener noreferrer">{hobby.linkText}</a>)}{hobby.after}</p>
								</div>
							</div>
						))
					}
				</div>
			</section>

			<section id="contact" class="cta-band">
				<h2>Have a project in mind?</h2>
				<p>Tell me what you're working on — I'd love to hear about it.</p>
				<a class="button button-inverse" href="mailto:97jake@gmail.com?subject=Consulting%20Inquiry"
					>Email Me</a
				>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
		max-width: 1080px;
		padding-top: 2em;
	}

	section {
		margin-bottom: 5em;
	}

	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.85em;
		font-weight: 700;
		color: var(--accent-teal-dark);
		margin-bottom: 0.5em;
	}

	.hero {
		display: flex;
		align-items: center;
		gap: 3em;
		background: linear-gradient(120deg, var(--tint-blue), var(--tint-teal));
		border-radius: 24px;
		padding: 3em;
	}

	.hero-text {
		flex: 1 1 55%;
	}

	.hero-text h1 {
		font-size: 2.6em;
		line-height: 1.15;
		margin-bottom: 0.2em;
	}

	.hero-text .tagline {
		font-weight: 700;
		color: var(--accent-dark);
		margin-bottom: 1em;
	}

	.hero-text .lede {
		font-size: 1.05em;
		color: rgb(var(--gray-dark));
	}

	.hero-image {
		flex: 0 0 auto;
		max-width: 240px;
	}

	.hero-image :global(img) {
		width: 100%;
		height: auto;
		border-radius: 16px;
		box-shadow: var(--box-shadow);
	}

	.hobby-cards {
		display: flex;
		flex-direction: column;
		gap: 1.25em;
		max-width: 460px;
		margin: 0 auto;
	}

	.hobby-card {
		display: flex;
		gap: 1em;
		align-items: flex-start;
		background: white;
		border-radius: 14px;
		border-left: 4px solid transparent;
		padding: 1.5em;
		box-shadow: var(--box-shadow);
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	.hobby-card:hover {
		transform: translateY(-4px) scale(1.02);
	}

	.hobby-icon {
		flex: 0 0 auto;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.75em;
		height: 2.75em;
		border-radius: 50%;
		font-size: 1.4em;
	}

	.hobby-body h3 {
		font-size: 1.1em;
		margin-bottom: 0.4em;
	}

	.hobby-body p {
		margin-bottom: 0;
		font-size: 0.95em;
		color: rgb(var(--gray-dark));
	}

	.hobby-cards .hobby-card:nth-child(3n + 1) {
		border-left-color: var(--accent);
	}

	.hobby-cards .hobby-card:nth-child(3n + 1) .hobby-icon {
		background: var(--tint-blue);
	}

	.hobby-cards .hobby-card:nth-child(3n + 1) h3 {
		color: var(--accent-dark);
	}

	.hobby-cards .hobby-card:nth-child(3n + 1):hover {
		box-shadow: 0 16px 32px rgba(var(--accent-rgb), 0.25);
	}

	.hobby-cards .hobby-card:nth-child(3n + 2) {
		border-left-color: var(--accent-teal);
	}

	.hobby-cards .hobby-card:nth-child(3n + 2) .hobby-icon {
		background: var(--tint-teal);
	}

	.hobby-cards .hobby-card:nth-child(3n + 2) h3 {
		color: var(--accent-teal-dark);
	}

	.hobby-cards .hobby-card:nth-child(3n + 2):hover {
		box-shadow: 0 16px 32px rgba(var(--accent-teal-rgb), 0.25);
	}

	.hobby-cards .hobby-card:nth-child(3n + 3) {
		border-left-color: var(--accent-purple);
	}

	.hobby-cards .hobby-card:nth-child(3n + 3) .hobby-icon {
		background: var(--tint-purple);
	}

	.hobby-cards .hobby-card:nth-child(3n + 3) h3 {
		color: var(--accent-purple-dark);
	}

	.hobby-cards .hobby-card:nth-child(3n + 3):hover {
		box-shadow: 0 16px 32px rgba(var(--accent-purple-rgb), 0.25);
	}

	.cta-band {
		background: linear-gradient(135deg, var(--accent-purple), var(--accent), var(--accent-teal));
		color: white;
		text-align: center;
		border-radius: 16px;
		padding: 3em 2em;
		margin-bottom: 1em;
	}

	.cta-band h2 {
		text-align: center;
		margin-bottom: 1em;
	}

	.cta-band p {
		font-size: 1.1em;
	}

	.button,
	.button-inverse {
		display: inline-block;
		padding: 0.75em 1.5em;
		border-radius: 8px;
		font-weight: 700;
		text-decoration: none;
		transition:
			background-color 0.2s ease,
			color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.button-inverse {
		background: white;
		color: var(--accent-dark);
	}

	.button-inverse:hover {
		background: rgb(var(--gray-light));
		color: var(--accent-dark);
	}

	@media (max-width: 720px) {
		.hero {
			flex-direction: column;
			gap: 1.5em;
			padding: 1.75em;
			text-align: center;
		}

		.hero-image {
			max-width: 200px;
		}

		.hero-text h1 {
			font-size: 2em;
		}

		section {
			margin-bottom: 3.5em;
		}
	}
</style>

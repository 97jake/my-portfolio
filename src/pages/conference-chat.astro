---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const pageDescription = 'Ask questions over 50+ years of LDS General Conference talks, with citations.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`General Conference Chat | ${SITE_TITLE}`} description={pageDescription} />
	</head>
	<body>
		<Header />
		<main>
			<section class="chat-page">
				<div class="chat-intro">
					<p class="eyebrow">RAG Demo</p>
					<h1>General Conference Chat</h1>
					<p class="lede">
						Retrieval-augmented search over every LDS General Conference talk since 1971. Ask about a
						topic, a specific speaker, or an era -- answers cite their sources.
					</p>
				</div>

				<div class="chat-window">
					<div id="chat-log" class="chat-log" aria-live="polite"></div>
					<form id="chat-form" class="chat-form">
						<textarea
							id="chat-input"
							class="chat-input"
							placeholder="Ask about a topic, speaker, or era..."
							rows="1"
							autocomplete="off"
						></textarea>
						<button id="chat-send" class="button" type="submit" aria-label="Send message">
							<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
								<path d="M12 19V5M5 12l7-7 7 7" />
							</svg>
						</button>
					</form>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
		max-width: 820px;
		padding-top: 1em;
	}

	.chat-page {
		display: flex;
		flex-direction: column;
		gap: 0.85em;
	}

	.chat-intro {
		text-align: center;
	}

	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.85em;
		font-weight: 700;
		color: var(--accent-teal-dark);
		margin-bottom: 0.3em;
	}

	.chat-intro h1 {
		margin-bottom: 0.2em;
	}

	.chat-intro .lede {
		color: rgb(var(--gray-dark));
		margin-bottom: 0;
	}

	.chat-window {
		display: flex;
		flex-direction: column;
		background: white;
		border-radius: 16px;
		box-shadow: var(--box-shadow);
		overflow: hidden;
		height: 90vh;
		min-height: 420px;
	}

	.chat-log {
		flex: 1 1 auto;
		overflow-y: auto;
		padding: 1.5em;
		display: flex;
		flex-direction: column;
	}

	/*
	  Messages are created client-side with document.createElement, so they
	  never receive Astro's scoped data-astro-cid attribute. These rules must
	  stay :global() or they will silently fail to apply.
	*/
	:global(.chat-log .message-row) {
		display: flex;
		width: 100%;
		margin-top: 0.2em;
	}

	:global(.chat-log .message-row:first-child) {
		margin-top: 0;
	}

	:global(.chat-log .message-row.group-start) {
		margin-top: 0.85em;
	}

	:global(.chat-log .message-row.user) {
		justify-content: flex-end;
	}

	:global(.chat-log .message-row.assistant) {
		justify-content: flex-start;
	}

	:global(.chat-log .message-row.error) {
		justify-content: center;
	}

	:global(.chat-log .bubble) {
		max-width: 78%;
		padding: 0.65em 1em;
		border-radius: 18px;
		line-height: 1.45;
		white-space: pre-wrap;
		word-wrap: break-word;
		font-size: 0.95em;
	}

	:global(.chat-log .message-row.user .bubble) {
		background: linear-gradient(135deg, var(--accent), var(--accent-dark));
		color: white;
		border-bottom-right-radius: 5px;
	}

	:global(.chat-log .message-row.assistant .bubble) {
		background: rgb(var(--gray-light));
		color: rgb(var(--gray-dark));
		border-bottom-left-radius: 5px;
	}

	:global(.chat-log .bubble a) {
		color: inherit;
		text-decoration: underline;
	}

	:global(.chat-log .bubble code) {
		background: rgba(0, 0, 0, 0.08);
		padding: 0.15em 0.35em;
		border-radius: 4px;
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.9em;
	}

	:global(.chat-log .message-row.error .bubble) {
		background: transparent;
		color: #b3261e;
		font-size: 0.85em;
		font-style: italic;
		text-align: center;
		padding: 0.25em 1em;
		max-width: 100%;
	}

	:global(.chat-log .bubble-meta) {
		margin-top: 0.3em;
		font-size: 0.78em;
		color: rgb(var(--gray));
	}

	:global(.chat-log .bubble.typing) {
		display: flex;
		align-items: center;
		gap: 0.3em;
		padding: 0.9em 1.1em;
	}

	:global(.chat-log .bubble.typing span) {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: rgb(var(--gray));
		animation: conference-chat-typing 1.2s infinite ease-in-out;
	}

	:global(.chat-log .bubble.typing span:nth-child(2)) {
		animation-delay: 0.15s;
	}

	:global(.chat-log .bubble.typing span:nth-child(3)) {
		animation-delay: 0.3s;
	}

	@keyframes conference-chat-typing {
		0%,
		60%,
		100% {
			transform: translateY(0);
			opacity: 0.5;
		}
		30% {
			transform: translateY(-4px);
			opacity: 1;
		}
	}

	.chat-form {
		display: flex;
		gap: 0.6em;
		align-items: flex-end;
		padding: 0.85em 1em;
		border-top: 1px solid rgb(var(--gray-light));
		background: #fafbfd;
	}

	.chat-input {
		flex: 1 1 auto;
		resize: none;
		max-height: 8em;
		padding: 0.65em 1em;
		border-radius: 20px;
		border: 1px solid rgb(var(--gray-light));
		font-family: var(--font-atkinson);
		line-height: 1.4;
		background: white;
	}

	.chat-input:focus {
		outline: 2px solid var(--accent);
		outline-offset: 1px;
	}

	.chat-form .button {
		flex: 0 0 auto;
		width: 42px;
		height: 42px;
		padding: 0;
		border-radius: 50%;
		border: none;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--accent);
		color: white;
		cursor: pointer;
		transition: background-color 0.2s ease, transform 0.1s ease;
	}

	.chat-form .button:hover:not(:disabled) {
		background: var(--accent-dark);
	}

	.chat-form .button:active:not(:disabled) {
		transform: scale(0.92);
	}

	.chat-form .button:disabled {
		background: rgb(var(--gray-light));
		color: rgb(var(--gray));
		cursor: not-allowed;
	}

	@media (max-width: 600px) {
		.chat-window {
			height: 90vh;
			border-radius: 12px;
		}

		:global(.chat-log .bubble) {
			max-width: 90%;
		}
	}
</style>

<script>
	interface ChatResponse {
		answer: string;
		speaker_filter: string | null;
		year_range: [number | null, number | null] | null;
		num_matches: number;
	}

	interface ErrorResponse {
		error: string;
	}

	const log = document.getElementById('chat-log') as HTMLDivElement;
	const form = document.getElementById('chat-form') as HTMLFormElement;
	const input = document.getElementById('chat-input') as HTMLTextAreaElement;
	const sendButton = document.getElementById('chat-send') as HTMLButtonElement;

	let sending = false;
	let lastRole: string | null = null;

	function autoResize() {
		input.style.height = 'auto';
		input.style.height = `${Math.min(input.scrollHeight, 128)}px`;
	}

	function scrollToBottom() {
		log.scrollTop = log.scrollHeight;
	}

	function escapeHtml(text: string): string {
		return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
	}

	// The model replies with light markdown (bold, headings, links). We escape
	// the raw text first and only ever introduce our own fixed set of tags, so
	// this stays safe to drop in via innerHTML even though the source is model
	// output.
	function renderMarkdownLite(text: string): string {
		let html = escapeHtml(text);
		html = html.replace(/^#{1,6}\s+(.+)$/gm, '<strong>$1</strong>');
		html = html.replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>');
		html = html.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
		html = html.replace(/(?<!\*)\*([^*\n]+)\*(?!\*)/g, '<em>$1</em>');
		html = html.replace(/\n/g, '<br>');
		return html;
	}

	function createBubble(
		role: 'user' | 'assistant' | 'error',
		opts: { typing?: boolean } = {},
	): { row: HTMLDivElement; bubble: HTMLDivElement } {
		const row = document.createElement('div');
		const groupStart = role !== lastRole;
		row.className = `message-row ${role}${groupStart ? ' group-start' : ''}`;
		lastRole = role === 'error' ? null : role;

		const bubble = document.createElement('div');
		bubble.className = 'bubble';
		if (opts.typing) {
			bubble.classList.add('typing');
			bubble.innerHTML = '<span></span><span></span><span></span>';
		}

		row.appendChild(bubble);
		log.appendChild(row);
		scrollToBottom();
		return { row, bubble };
	}

	function appendMessage(role: 'user' | 'assistant' | 'error', text: string): void {
		const { bubble } = createBubble(role);
		bubble.textContent = text;
	}

	function appendAssistantReply(data: ChatResponse): void {
		const { bubble } = createBubble('assistant');
		bubble.innerHTML = renderMarkdownLite(data.answer);

		const metaParts: string[] = [];
		if (data.speaker_filter) metaParts.push(`speaker: ${data.speaker_filter}`);
		if (data.year_range) {
			const [start, end] = data.year_range;
			metaParts.push(`years: ${start ?? '...'}-${end ?? 'present'}`);
		}
		metaParts.push(`${data.num_matches} matching excerpt${data.num_matches === 1 ? '' : 's'}`);

		const meta = document.createElement('div');
		meta.className = 'bubble-meta';
		meta.textContent = metaParts.join(' · ');
		bubble.parentElement!.appendChild(meta);
		scrollToBottom();
	}

	function setSending(value: boolean) {
		sending = value;
		input.disabled = value;
		sendButton.disabled = value;
	}

	appendMessage(
		'assistant',
		"Ask me anything about General Conference talks -- a topic, a specific speaker, or an era. The first question after a quiet period can take up to a minute while the backend wakes up.",
	);

	const RETRY_DELAY_MS = 4000;

	async function askBackend(question: string): Promise<ChatResponse> {
		const response = await fetch('/api/conference-chat', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({ question }),
		});
		const data = (await response.json()) as ChatResponse | ErrorResponse;
		if (!response.ok) {
			throw new Error((data as ErrorResponse).error ?? `Request failed (${response.status})`);
		}
		return data as ChatResponse;
	}

	async function sendMessage(question: string) {
		appendMessage('user', question);

		const { row: typingRow, bubble: typingBubble } = createBubble('assistant', { typing: true });
		setSending(true);

		try {
			let data: ChatResponse;
			try {
				data = await askBackend(question);
			} catch (err) {
				// Netlify's function timeout can be shorter than Render's free-tier
				// cold-start time, so the first request after idle may fail even
				// though the backend is still fine -- one silent retry covers that
				// without the visitor needing to notice or resubmit.
				typingBubble.classList.add('typing');
				await new Promise((resolve) => setTimeout(resolve, RETRY_DELAY_MS));
				data = await askBackend(question);
			}
			typingRow.remove();
			lastRole = null;
			appendAssistantReply(data);
		} catch (err) {
			typingRow.remove();
			lastRole = null;
			appendMessage('error', err instanceof Error ? err.message : 'Something went wrong. Please try again.');
		} finally {
			setSending(false);
			input.focus();
		}
	}

	form.addEventListener('submit', (e) => {
		e.preventDefault();
		if (sending) return;
		const text = input.value.trim();
		if (!text) return;
		input.value = '';
		autoResize();
		sendMessage(text);
	});

	input.addEventListener('input', autoResize);

	input.addEventListener('keydown', (e) => {
		if (e.key === 'Enter' && !e.shiftKey) {
			e.preventDefault();
			form.requestSubmit();
		}
	});
</script>

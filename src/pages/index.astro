---
import BaseHead from '../components/BaseHead.astro';
import { Image } from 'astro:assets';
import HeroPhoto from '../assets/headshot.jpg';

const work = [
	{
		name: 'FizzPal',
		detail: 'A soda-tracking iOS app: designed, built, and shipped independently',
		meta: 'Swift · 2026',
		href: 'https://github.com/97jake/fizz-pal',
	},
];

const writing = [
	{
		name: 'Predicting a Hit',
		meta: 'Oct 10, 2026',
		href: '/blog/predicting-a-hit/',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Jake Snow — Website redesign & development"
			description="I redesign business websites to be fast, sharp, and built to win you work. Website redesign and development by Jake Snow, software developer in Arlington, VA."
		/>
	</head>
	<body class="home">
		<div class="page">
			<nav class="nav" aria-label="Main navigation">
				<a class="logo" href="/">Jake Snow</a>
				<div class="nav-links">
					<a href="#work">Work</a>
					<a href="/blog">Writing</a>
					<a href="#about">About</a>
					<a href="/experience">Experience</a>
					<a href="/contact">Contact</a>
				</div>
			</nav>

			<main>
				<section class="hero">
					<div class="hero-text">
						<p class="eyebrow">Website redesign &amp; development</p>
						<h1>Websites that move your business forward.</h1>
						<p class="sub">
							I'm Jake Snow, a software developer in Arlington, VA. I redesign business
							websites to be fast, sharp, and built to win you work, with the same
							engineering rigor I spent four years applying at VideoAmp.
						</p>
						<div class="ctas">
							<a class="cta-primary" href="mailto:97jake@gmail.com">Get in touch</a>
							<a class="cta-secondary" href="#work">See my work</a>
						</div>
					</div>
					<Image
						class="photo"
						src={HeroPhoto}
						alt="Jake Snow"
						width={480}
						height={600}
					/>
				</section>
			</main>

			<div class="marquee" aria-hidden="true">
				<div class="marquee-track">
					<span>Redesign</span><span>·</span><span>Web development</span><span>·</span><span>Engagement Optimization</span><span>·</span><span>AI Strategy</span><span>·</span>
					<span>Redesign</span><span>·</span><span>Web development</span><span>·</span><span>Engagement Optimization</span><span>·</span><span>AI Strategy</span><span>·</span>
					<span>Redesign</span><span>·</span><span>Web development</span><span>·</span><span>Engagement Optimization</span><span>·</span><span>AI Strategy</span><span>·</span>
				</div>
			</div>

			<main>
				<section class="section" id="work">
					<h2>Selected work</h2>
					<div class="list">
						{
							work.map((item) => (
								<a class="item" href={item.href}>
									<span class="item-name">{item.name}</span>
									<span class="item-detail">{item.detail}</span>
									<span class="item-meta">{item.meta}</span>
								</a>
							))
						}
						<div class="item item-placeholder">
							<span class="item-name">Your next project</span>
							<span class="item-detail">This slot is ready for your first redesign case study</span>
							<span class="item-meta">Placeholder</span>
						</div>
					</div>
				</section>

				<section class="section" id="writing">
					<h2>Writing</h2>
					<div class="list">
						{
							writing.map((item) => (
								<a class="item" href={item.href}>
									<span class="item-name">{item.name}</span>
									<span class="item-meta">{item.meta}</span>
								</a>
							))
						}
					</div>
				</section>

				<section class="section" id="about">
					<h2>About</h2>
					<p class="body-text">
						Applied math grad turned software developer. Previously Senior ML Engineer and
						Data Engineer at VideoAmp: ML pipelines over 100M+ row datasets, ETL runtimes
						cut from 2 hours to 10 minutes. Off the clock I'm birding, reading, at the
						movies on my AMC A-List, or delivering groceries with the Arlington Food
						Assistance Center. <a href="/about">More about me</a>.
					</p>
				</section>
			</main>

			<footer class="footer">
				<a href="mailto:97jake@gmail.com">97jake@gmail.com</a>
				<a href="https://github.com/97jake">github.com/97jake</a>
			</footer>
		</div>
	</body>
</html>

<style>
	:global(body.home) {
		background: #f5efe7;
		background-image: none;
		color: #1f1a17;
		font-size: 16px;
		line-height: 1.55;
	}
	main {
		width: auto;
		max-width: none;
		margin: 0;
		padding: 0;
	}
	.page {
		--cream: #f5efe7;
		--ink: #1f1a17;
		--ink-2: #6b6157;
		--accent: #c2521e;
		--line: #e3dacd;
		max-width: 1080px;
		margin: 0 auto;
	}
	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 8px;
		padding: 20px 28px;
	}
	.logo {
		font-weight: 700;
		font-size: 20px;
		letter-spacing: -0.02em;
		color: var(--ink);
		text-decoration: none;
	}
	.nav-links {
		display: flex;
		flex-wrap: wrap;
		gap: 22px;
	}
	.nav-links a {
		color: var(--ink-2);
		text-decoration: none;
		font-size: 14px;
		min-height: 32px;
		display: inline-flex;
		align-items: center;
	}
	.nav-links a:hover {
		color: var(--ink);
	}
	.hero {
		display: flex;
		gap: 32px;
		align-items: center;
		flex-wrap: wrap;
		padding: 44px 28px 52px;
	}
	.hero-text {
		flex: 1 1 320px;
		min-width: 0;
	}
	.eyebrow {
		margin: 0 0 14px;
		font-size: 12px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent);
		font-weight: 700;
	}
	h1 {
		margin: 0 0 18px;
		font-weight: 700;
		font-size: clamp(34px, 7vw, 60px);
		line-height: 1.04;
		letter-spacing: -0.025em;
		color: var(--ink);
	}
	.sub {
		margin: 0 0 26px;
		font-size: 16px;
		line-height: 1.55;
		color: var(--ink-2);
		max-width: 46ch;
	}
	.ctas {
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
	}
	.cta-primary,
	.cta-secondary {
		display: inline-flex;
		align-items: center;
		min-height: 46px;
		padding: 0 22px;
		border-radius: 999px;
		font-size: 15px;
		font-weight: 700;
		text-decoration: none;
	}
	.cta-primary {
		background: var(--ink);
		color: #fbf8f3;
	}
	.cta-secondary {
		border: 1px solid var(--ink);
		color: var(--ink);
	}
	.photo {
		flex: 0 1 240px;
		width: 240px;
		height: auto;
		max-width: 46%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: 16px;
		transform: rotate(2deg);
		box-shadow: 0 18px 40px -18px rgba(31, 26, 23, 0.45);
	}
	.marquee {
		overflow: hidden;
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}
	.marquee-track {
		display: flex;
		gap: 28px;
		width: max-content;
		padding: 12px 0;
		font-size: 13px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ink-2);
		animation: scroll 26s linear infinite;
	}
	@keyframes scroll {
		to {
			transform: translateX(-33.333%);
		}
	}
	.section {
		padding: 36px 28px 8px;
	}
	h2 {
		margin: 0 0 8px;
		font-weight: 700;
		font-size: 26px;
		letter-spacing: -0.02em;
		color: var(--ink);
	}
	.list {
		display: flex;
		flex-direction: column;
	}
	.item {
		display: flex;
		align-items: baseline;
		gap: 14px;
		flex-wrap: wrap;
		padding: 16px 0;
		border-bottom: 1px solid var(--line);
		text-decoration: none;
		color: inherit;
	}
	a.item:hover .item-name {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.item-name {
		font-weight: 700;
		font-size: 16px;
	}
	.item-detail {
		color: var(--ink-2);
		font-size: 14px;
		flex: 1 1 200px;
	}
	.item-meta {
		color: var(--ink-2);
		font-size: 13px;
		margin-left: auto;
	}
	.item-placeholder {
		opacity: 0.62;
		border-bottom-style: dashed;
	}
	.body-text {
		margin: 0;
		font-size: 15px;
		line-height: 1.6;
		color: var(--ink-2);
		max-width: 62ch;
	}
	.body-text a {
		color: var(--accent);
	}
	.footer {
		display: flex;
		gap: 24px;
		flex-wrap: wrap;
		margin-top: 36px;
		padding: 22px 28px 26px;
		border-top: 1px solid var(--line);
	}
	.footer a {
		color: var(--ink-2);
		font-size: 14px;
		text-decoration: none;
		min-height: 32px;
		display: inline-flex;
		align-items: center;
	}
	.footer a:hover {
		color: var(--ink);
	}
	@media (max-width: 600px) {
		.nav {
			flex-direction: column;
			gap: 2px;
			padding: 12px 8px;
		}
		.nav-links {
			justify-content: center;
			gap: 4px 12px;
		}
		.nav-links a {
			font-size: 12.5px;
			min-height: 30px;
		}
		.photo {
			max-width: 70%;
			margin: 0 auto;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.marquee-track {
			animation: none;
		}
	}
</style>

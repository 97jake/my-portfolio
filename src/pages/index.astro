---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Welcome to Jake's Place!</h1>
			<p>
				Since I graduated with my degree in Applied Mathematics in 2022, I've been dedicated to 
				building next-generation AI/ML pipelines. AI has the potential to completely change how 
				you do business, and I want to help you unlock that potential.
			</p>
			<p>
				If you've wanting to add AI to your business or improve how you're using it right now, let's talk!
			</p>
		</main>
		<Footer />
	</body>
</html>

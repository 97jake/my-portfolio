---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const pageDescription = 'Chat with DJMe, an AI assistant powered by Claude.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`DJMe | ${SITE_TITLE}`} description={pageDescription} />
	</head>
	<body>
		<Header />
		<main>
			<section class="chat-page">
				<div class="chat-intro">
					<p class="eyebrow">DJMe</p>
					<h1>Chat with DJMe</h1>
					<p class="lede">A small AI chat demo running on Claude. Ask it anything.</p>
				</div>

				<div id="spotify-status" class="spotify-status">
					<span id="spotify-status-text">Checking Spotify…</span>
					<a id="spotify-connect" class="button" href="/api/auth/login" hidden>Connect Spotify</a>
					<button id="spotify-disconnect" class="button" type="button" hidden>Disconnect</button>
				</div>

				<div class="chat-window">
					<div id="chat-log" class="chat-log" aria-live="polite"></div>
					<form id="chat-form" class="chat-form">
						<textarea
							id="chat-input"
							class="chat-input"
							placeholder="Message DJMe…"
							rows="1"
							autocomplete="off"
						></textarea>
						<button id="chat-send" class="button" type="submit" aria-label="Send message">
							<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
								<path d="M12 19V5M5 12l7-7 7 7" />
							</svg>
						</button>
					</form>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
		max-width: 820px;
		padding-top: 1em;
	}

	.chat-page {
		display: flex;
		flex-direction: column;
		gap: 0.85em;
	}

	.chat-intro {
		text-align: center;
	}

	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.85em;
		font-weight: 700;
		color: var(--accent-teal-dark);
		margin-bottom: 0.3em;
	}

	.chat-intro h1 {
		margin-bottom: 0.2em;
	}

	.chat-intro .lede {
		color: rgb(var(--gray-dark));
		margin-bottom: 0;
	}

	.spotify-status {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75em;
		font-size: 0.9em;
		color: rgb(var(--gray-dark));
	}

	.spotify-status .button {
		padding: 0.4em 1em;
		border-radius: 10px;
		border: none;
		font-weight: 700;
		font-family: var(--font-atkinson);
		font-size: 0.9em;
		background: var(--accent);
		color: white;
		cursor: pointer;
		text-decoration: none;
		transition: background-color 0.2s ease;
	}

	.spotify-status .button:hover {
		background: var(--accent-dark);
	}

	.spotify-status #spotify-disconnect {
		background: transparent;
		color: rgb(var(--gray-dark));
		border: 1px solid rgb(var(--gray-light));
	}

	.spotify-status #spotify-disconnect:hover {
		background: rgb(var(--gray-light));
	}

	.chat-window {
		display: flex;
		flex-direction: column;
		background: white;
		border-radius: 16px;
		box-shadow: var(--box-shadow);
		overflow: hidden;
		height: 90vh;
		min-height: 420px;
	}

	.chat-log {
		flex: 1 1 auto;
		overflow-y: auto;
		padding: 1.5em;
		display: flex;
		flex-direction: column;
	}

	/*
	  Messages are created client-side with document.createElement, so they
	  never receive Astro's scoped data-astro-cid attribute. These rules must
	  stay :global() or they will silently fail to apply.
	*/
	:global(.chat-log .message-row) {
		display: flex;
		width: 100%;
		margin-top: 0.2em;
	}

	:global(.chat-log .message-row:first-child) {
		margin-top: 0;
	}

	:global(.chat-log .message-row.group-start) {
		margin-top: 0.85em;
	}

	:global(.chat-log .message-row.user) {
		justify-content: flex-end;
	}

	:global(.chat-log .message-row.assistant) {
		justify-content: flex-start;
	}

	:global(.chat-log .message-row.error) {
		justify-content: center;
	}

	:global(.chat-log .bubble) {
		max-width: 78%;
		padding: 0.65em 1em;
		border-radius: 18px;
		line-height: 1.45;
		white-space: pre-wrap;
		word-wrap: break-word;
		font-size: 0.95em;
	}

	:global(.chat-log .message-row.user .bubble) {
		background: linear-gradient(135deg, var(--accent), var(--accent-dark));
		color: white;
		border-bottom-right-radius: 5px;
	}

	:global(.chat-log .message-row.assistant .bubble) {
		background: rgb(var(--gray-light));
		color: rgb(var(--gray-dark));
		border-bottom-left-radius: 5px;
	}

	:global(.chat-log .bubble a) {
		color: inherit;
		text-decoration: underline;
	}

	:global(.chat-log .bubble code) {
		background: rgba(0, 0, 0, 0.08);
		padding: 0.15em 0.35em;
		border-radius: 4px;
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.9em;
	}

	:global(.chat-log .message-row.user .bubble code) {
		background: rgba(255, 255, 255, 0.2);
	}

	:global(.chat-log .message-row.error .bubble) {
		background: transparent;
		color: #b3261e;
		font-size: 0.85em;
		font-style: italic;
		text-align: center;
		padding: 0.25em 1em;
		max-width: 100%;
	}

	:global(.chat-log .song-list) {
		display: flex;
		flex-direction: column;
		gap: 0.5em;
		max-width: 78%;
	}

	:global(.chat-log .song-card) {
		display: flex;
		align-items: center;
		gap: 0.75em;
		background: #111214;
		border-radius: 14px;
		padding: 0.5em 1em 0.5em 0.5em;
		border: 2px solid transparent;
		width: 100%;
		font: inherit;
		text-align: left;
		color: inherit;
		cursor: pointer;
		transition: border-color 0.15s ease, background-color 0.15s ease, transform 0.1s ease;
	}

	:global(.chat-log .song-card:hover:not(:disabled)) {
		border-color: rgba(255, 255, 255, 0.25);
	}

	:global(.chat-log .song-card:active:not(:disabled)) {
		transform: scale(0.98);
	}

	:global(.chat-log .song-card.selected) {
		border-color: var(--accent);
		background: #1a1d22;
	}

	:global(.chat-log .song-card:disabled) {
		cursor: default;
		opacity: 0.75;
	}

	/* playlist_preview cards are plain divs, not buttons — read-only, no
	   hover/active affordance since there's nothing to click. */
	:global(.chat-log .song-card.read-only) {
		cursor: default;
	}

	:global(.chat-log .song-card.read-only:hover) {
		border-color: transparent;
	}

	:global(.chat-log .song-check) {
		flex: 0 0 auto;
		width: 20px;
		height: 20px;
		margin-left: auto;
		border-radius: 50%;
		border: 2px solid rgba(255, 255, 255, 0.3);
		position: relative;
		transition: border-color 0.15s ease, background-color 0.15s ease;
	}

	:global(.chat-log .song-card.selected .song-check) {
		border-color: var(--accent);
		background: var(--accent);
	}

	:global(.chat-log .song-card.selected .song-check::after) {
		content: '';
		position: absolute;
		left: 6px;
		top: 2px;
		width: 5px;
		height: 9px;
		border: solid white;
		border-width: 0 2px 2px 0;
		transform: rotate(45deg);
	}

	:global(.chat-log .song-list-confirm) {
		align-self: flex-start;
		margin-top: 0.2em;
		padding: 0.5em 1.1em;
		border-radius: 20px;
		border: none;
		background: var(--accent);
		color: white;
		font-family: var(--font-atkinson);
		font-weight: 700;
		font-size: 0.85em;
		cursor: pointer;
		transition: background-color 0.2s ease;
	}

	:global(.chat-log .song-list-confirm:hover:not(:disabled)) {
		background: var(--accent-dark);
	}

	:global(.chat-log .song-list-confirm:disabled) {
		background: rgb(var(--gray-light));
		color: rgb(var(--gray));
		cursor: default;
	}

	:global(.chat-log .song-art) {
		flex: 0 0 auto;
		width: 48px;
		height: 48px;
		border-radius: 8px;
		background: #333438;
		overflow: hidden;
	}

	:global(.chat-log .song-art img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	:global(.chat-log .song-info) {
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 0.15em;
	}

	:global(.chat-log .song-title) {
		color: #fff;
		font-weight: 700;
		font-size: 0.95em;
		line-height: 1.25;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	:global(.chat-log .song-artist) {
		color: #a7a7a7;
		font-size: 0.85em;
		line-height: 1.25;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	:global(.chat-log .bubble.typing) {
		display: flex;
		align-items: center;
		gap: 0.3em;
		padding: 0.9em 1.1em;
	}

	:global(.chat-log .bubble.typing span) {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: rgb(var(--gray));
		animation: djme-typing 1.2s infinite ease-in-out;
	}

	:global(.chat-log .bubble.typing span:nth-child(2)) {
		animation-delay: 0.15s;
	}

	:global(.chat-log .bubble.typing span:nth-child(3)) {
		animation-delay: 0.3s;
	}

	@keyframes djme-typing {
		0%,
		60%,
		100% {
			transform: translateY(0);
			opacity: 0.5;
		}
		30% {
			transform: translateY(-4px);
			opacity: 1;
		}
	}

	.chat-form {
		display: flex;
		gap: 0.6em;
		align-items: flex-end;
		padding: 0.85em 1em;
		border-top: 1px solid rgb(var(--gray-light));
		background: #fafbfd;
	}

	.chat-input {
		flex: 1 1 auto;
		resize: none;
		max-height: 8em;
		padding: 0.65em 1em;
		border-radius: 20px;
		border: 1px solid rgb(var(--gray-light));
		font-family: var(--font-atkinson);
		line-height: 1.4;
		background: white;
	}

	.chat-input:focus {
		outline: 2px solid var(--accent);
		outline-offset: 1px;
	}

	.chat-form .button {
		flex: 0 0 auto;
		width: 42px;
		height: 42px;
		padding: 0;
		border-radius: 50%;
		border: none;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--accent);
		color: white;
		cursor: pointer;
		transition: background-color 0.2s ease, transform 0.1s ease;
	}

	.chat-form .button:hover:not(:disabled) {
		background: var(--accent-dark);
	}

	.chat-form .button:active:not(:disabled) {
		transform: scale(0.92);
	}

	.chat-form .button:disabled {
		background: rgb(var(--gray-light));
		color: rgb(var(--gray));
		cursor: not-allowed;
	}

	@media (max-width: 600px) {
		.chat-window {
			height: 90vh;
			border-radius: 12px;
		}

		:global(.chat-log .bubble) {
			max-width: 90%;
		}

		:global(.chat-log .song-list) {
			max-width: 90%;
		}
	}
</style>

<script>
	interface ChatMessage {
		role: 'user' | 'assistant';
		// A plain string for user turns; assistant turns round-tripped from the
		// server's `history` event may carry structured tool_use/tool_result
		// blocks instead, which we just store and relay, not interpret.
		content: unknown;
	}

	const log = document.getElementById('chat-log') as HTMLDivElement;
	const form = document.getElementById('chat-form') as HTMLFormElement;
	const input = document.getElementById('chat-input') as HTMLTextAreaElement;
	const sendButton = document.getElementById('chat-send') as HTMLButtonElement;

	const chatHistory: ChatMessage[] = [];
	let sending = false;

	function autoResize() {
		input.style.height = 'auto';
		input.style.height = `${Math.min(input.scrollHeight, 128)}px`;
	}

	function scrollToBottom() {
		log.scrollTop = log.scrollHeight;
	}

	const TOOL_DESCRIPTIONS: Record<string, string> = {
		search_spotify: "Let me search Spotify for some tracks that fit the vibe…",
		create_playlist: 'Creating your playlist now…',
		add_tracks_to_playlist: 'Adding those tracks to your playlist…',
		get_library_tracks: 'Let me check your library for inspiration…',
	};

	function describeToolUse(name: string): string {
		return TOOL_DESCRIPTIONS[name] ?? `Using ${name}…`;
	}

	function escapeHtml(text: string): string {
		return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
	}

	// The model replies with light markdown (bold, links, etc). We escape the
	// raw text first and only ever introduce our own fixed set of tags, so this
	// stays safe to drop in via innerHTML even though the source is model output.
	function renderMarkdownLite(text: string): string {
		let html = escapeHtml(text);
		html = html.replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>');
		html = html.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
		html = html.replace(/(?<!\*)\*([^*\n]+)\*(?!\*)/g, '<em>$1</em>');
		html = html.replace(/`([^`]+)`/g, '<code>$1</code>');
		html = html.replace(/\n/g, '<br>');
		return html;
	}

	let lastRole: string | null = null;

	function createBubble(
		role: 'user' | 'assistant' | 'error',
		text: string,
		opts: { typing?: boolean } = {},
	): { row: HTMLDivElement; bubble: HTMLDivElement } {
		const row = document.createElement('div');
		const groupStart = role !== lastRole;
		row.className = `message-row ${role}${groupStart ? ' group-start' : ''}`;
		lastRole = role === 'error' ? null : role;

		const bubble = document.createElement('div');
		bubble.className = 'bubble';
		if (opts.typing) {
			bubble.classList.add('typing');
			bubble.innerHTML = '<span></span><span></span><span></span>';
		} else {
			bubble.textContent = text;
		}

		row.appendChild(bubble);
		log.appendChild(row);
		scrollToBottom();
		return { row, bubble };
	}

	function appendMessage(role: 'user' | 'assistant' | 'error', text: string): HTMLDivElement {
		return createBubble(role, text).bubble;
	}

	interface Track {
		uri: string;
		name: string;
		artists: string[];
		albumImage: string | null;
	}

	// Must match the `tracks` array's .max(30) in the present_songs tool schema
	// (src/lib/spotify/tools.ts) — a lower cap here would silently drop cards
	// for tracks that still get added to the playlist (create_playlist gets
	// its own track list, independent of what's rendered).
	const MAX_SONG_CARDS = 30;

	type PresentMode = 'seed_candidates' | 'playlist_preview';

	function buildCardContent(track: Track): DocumentFragment {
		const art = document.createElement('div');
		art.className = 'song-art';
		if (track.albumImage) {
			const img = document.createElement('img');
			img.src = track.albumImage;
			img.alt = '';
			art.appendChild(img);
		}

		const info = document.createElement('div');
		info.className = 'song-info';

		const title = document.createElement('div');
		title.className = 'song-title';
		title.textContent = track.name;

		const artist = document.createElement('div');
		artist.className = 'song-artist';
		artist.textContent = track.artists.join(', ');

		info.append(title, artist);

		const fragment = document.createDocumentFragment();
		fragment.append(art, info);
		return fragment;
	}

	// Renders present_songs results. "seed_candidates" cards are selectable —
	// the visitor's picks become the playlist's seed song(s) — with a confirm
	// button that reports the selection back into the chat. "playlist_preview"
	// cards are read-only: a preview of exactly what's about to be created,
	// with a single "Create Playlist" button that gates the actual
	// create_playlist call behind the visitor's confirmation.
	function renderSongCards(tracks: Track[], mode: PresentMode) {
		if (tracks.length === 0) return;

		const row = document.createElement('div');
		const groupStart = lastRole !== 'assistant';
		row.className = `message-row assistant${groupStart ? ' group-start' : ''}`;
		lastRole = null; // whatever follows should start a fresh group, not hug the cards

		const list = document.createElement('div');
		list.className = 'song-list';

		if (mode === 'seed_candidates') {
			const selected = new Map<string, Track>();

			const confirmBtn = document.createElement('button');
			confirmBtn.type = 'button';
			confirmBtn.className = 'song-list-confirm';
			confirmBtn.hidden = true;

			function updateConfirmButton() {
				confirmBtn.hidden = selected.size === 0;
				confirmBtn.textContent = `Use ${selected.size} selected song${selected.size === 1 ? '' : 's'}`;
			}

			for (const track of tracks.slice(0, MAX_SONG_CARDS)) {
				const card = document.createElement('button');
				card.type = 'button';
				card.className = 'song-card';
				card.setAttribute('aria-pressed', 'false');
				card.appendChild(buildCardContent(track));

				const check = document.createElement('div');
				check.className = 'song-check';
				card.appendChild(check);

				card.addEventListener('click', () => {
					const isSelected = card.classList.toggle('selected');
					card.setAttribute('aria-pressed', String(isSelected));
					if (isSelected) {
						selected.set(track.uri, track);
					} else {
						selected.delete(track.uri);
					}
					updateConfirmButton();
				});

				list.appendChild(card);
			}

			confirmBtn.addEventListener('click', () => {
				if (sending || selected.size === 0) return;
				for (const card of Array.from(list.children) as HTMLButtonElement[]) {
					card.disabled = true;
				}
				confirmBtn.disabled = true;
				confirmBtn.textContent = 'Songs added to the conversation';
				sendSeedSelection(Array.from(selected.values()));
			});

			list.appendChild(confirmBtn);
		} else {
			for (const track of tracks.slice(0, MAX_SONG_CARDS)) {
				const card = document.createElement('div');
				card.className = 'song-card read-only';
				card.appendChild(buildCardContent(track));
				list.appendChild(card);
			}

			const createBtn = document.createElement('button');
			createBtn.type = 'button';
			createBtn.className = 'song-list-confirm';
			createBtn.textContent = 'Create Playlist';
			createBtn.addEventListener('click', () => {
				if (sending) return;
				createBtn.disabled = true;
				createBtn.textContent = 'Creating playlist…';
				sendPlaylistConfirmation();
			});
			list.appendChild(createBtn);
		}

		row.appendChild(list);
		log.appendChild(row);
		scrollToBottom();
	}

	interface PresentSongsResult {
		tracks: Track[];
		mode: PresentMode;
	}

	// present_songs is the only tool whose results ever reach the visitor —
	// search_spotify and get_library_tracks are frequently used by the model
	// just to think, over far more tracks than should ever be shown, so their
	// raw output is intentionally never rendered.
	function parsePresentSongsResult(name: string, output: unknown): PresentSongsResult | null {
		if (name !== 'present_songs' || !output || typeof output !== 'object') return null;
		const { tracks, mode } = output as { tracks?: unknown; mode?: unknown };
		if (!Array.isArray(tracks) || tracks.length === 0) return null;
		return { tracks: tracks as Track[], mode: mode === 'playlist_preview' ? 'playlist_preview' : 'seed_candidates' };
	}

	function setSending(value: boolean) {
		sending = value;
		input.disabled = value;
		sendButton.disabled = value;
	}

	// Shown once on load, purely client-side. Not pushed into `chatHistory`:
	// chat APIs generally require the first message in a request to have role
	// "user", so a synthetic assistant turn can't be prepended there.
	appendMessage(
		'assistant',
		"Hey, I'm DJMe 🎧 — an AI DJ built into this site. Once you connect Spotify above, I can search for tracks, dig through your saved or top songs, and build real playlists straight into your account. Tell me the mood, genre, or occasion and I'll take it from there.",
	);

	async function sendMessage(text: string) {
		chatHistory.push({ role: 'user', content: text });
		appendMessage('user', text);
		await requestAssistantReply();
	}

	// Sends the user's seed-song picks as a plain-text turn carrying their URIs
	// (so the model can use them directly instead of re-searching), while the
	// visible bubble stays human-readable.
	async function sendSeedSelection(tracks: Track[]) {
		const describe = (t: Track) => `"${t.name}" by ${t.artists.join(', ')}`;
		appendMessage('user', `Let's use: ${tracks.map(describe).join(', ')}`);
		chatHistory.push({
			role: 'user',
			content: `I like these songs for the playlist — use them as seed tracks: ${tracks
				.map((t) => `${describe(t)} (${t.uri})`)
				.join(', ')}.`,
		});
		await requestAssistantReply();
	}

	// Sent when the visitor clicks "Create Playlist" on a playlist_preview —
	// the model is instructed to wait for exactly this confirmation before it
	// actually calls create_playlist.
	async function sendPlaylistConfirmation() {
		appendMessage('user', 'Create the playlist with those tracks.');
		chatHistory.push({
			role: 'user',
			content: 'Looks good — go ahead and create the playlist with exactly those tracks.',
		});
		await requestAssistantReply();
	}

	async function requestAssistantReply() {
		// The stream alternates between "status" bubbles (narrating a tool call)
		// and "text" bubbles (the actual reply). Each mode switch starts a fresh
		// bubble so a finished message never gets silently appended to later —
		// consecutive events in the same mode update/grow the one open bubble.
		let openRow: HTMLDivElement | null = null;
		let openBubble: HTMLDivElement | null = null;
		let openMode: 'pending' | 'status' | 'text' | null = null;
		let assistantText = '';

		({ row: openRow, bubble: openBubble } = createBubble('assistant', '', { typing: true }));
		openMode = 'pending';

		setSending(true);

		function openTextBubble() {
			if (openMode === 'pending') {
				openBubble!.classList.remove('typing');
				openBubble!.innerHTML = '';
			} else {
				({ row: openRow, bubble: openBubble } = createBubble('assistant', ''));
			}
			openMode = 'text';
			assistantText = '';
		}

		function openStatusBubble(label: string) {
			if (openMode === 'status') {
				openBubble!.textContent = label;
				return;
			}
			if (openMode === 'pending') {
				openBubble!.classList.remove('typing');
				openBubble!.innerHTML = '';
				openBubble!.textContent = label;
			} else {
				({ row: openRow, bubble: openBubble } = createBubble('assistant', label));
			}
			openMode = 'status';
		}

		try {
			const response = await fetch('/api/chat', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ messages: chatHistory }),
			});

			if (!response.ok || !response.body) {
				let message = `Request failed (${response.status})`;
				try {
					const errorBody = await response.json();
					if (typeof errorBody?.error === 'string') message = errorBody.error;
				} catch {
					// Response wasn't JSON (e.g. a non-JSON 500 from the platform) — keep the generic message.
				}
				throw new Error(message);
			}

			const reader = response.body.getReader();
			const decoder = new TextDecoder();
			let buffer = '';

			while (true) {
				const { done, value } = await reader.read();
				if (done) break;

				buffer += decoder.decode(value, { stream: true });
				const events = buffer.split('\n\n');
				buffer = events.pop() ?? '';

				for (const rawEvent of events) {
					const line = rawEvent.trim();
					if (!line.startsWith('data: ')) continue;

					const payload = JSON.parse(line.slice(6));

					if (payload.type === 'delta') {
						if (openMode !== 'text') openTextBubble();
						assistantText += payload.text;
						openBubble!.innerHTML = renderMarkdownLite(assistantText);
						scrollToBottom();
					} else if (payload.type === 'tool') {
						// present_songs is a pure UI signal, not an action worth narrating —
						// its cards speak for themselves once the tool-result arrives.
						if (payload.name !== 'present_songs') {
							openStatusBubble(describeToolUse(payload.name));
							scrollToBottom();
						}
					} else if (payload.type === 'tool-result') {
						const presented = parsePresentSongsResult(payload.name, payload.output);
						if (presented) {
							// present_songs skips the status bubble, so if it's the first
							// tool call this turn, the placeholder "typing" bubble is still
							// open and needs clearing before the cards render.
							if (openMode === 'pending') openRow!.remove();
							renderSongCards(presented.tracks, presented.mode);
							// The status bubble narrating the tool call is now stale; the
							// next event (more tool calls or the reply) should open fresh.
							openMode = null;
						}
					} else if (payload.type === 'history') {
						// The server's record of what actually happened this turn —
						// including real tool_use/tool_result blocks — replaces any
						// need to reconstruct history from the plain text we rendered.
						chatHistory.push(...payload.messages);
					} else if (payload.type === 'error') {
						openRow!.remove();
						appendMessage('error', payload.message ?? 'Something went wrong.');
						return;
					}
				}
			}

			if (openMode === 'pending') {
				openRow!.remove();
			}
		} catch (err) {
			openRow?.remove();
			appendMessage('error', err instanceof Error ? err.message : 'Something went wrong. Please try again.');
			chatHistory.pop();
		} finally {
			setSending(false);
			input.focus();
		}
	}

	form.addEventListener('submit', (e) => {
		e.preventDefault();
		if (sending) return;
		const text = input.value.trim();
		if (!text) return;
		input.value = '';
		autoResize();
		sendMessage(text);
	});

	input.addEventListener('input', autoResize);

	input.addEventListener('keydown', (e) => {
		if (e.key === 'Enter' && !e.shiftKey) {
			e.preventDefault();
			form.requestSubmit();
		}
	});

	interface SpotifyStatus {
		connected: boolean;
		displayName?: string | null;
	}

	const spotifyStatusText = document.getElementById('spotify-status-text') as HTMLSpanElement;
	const spotifyConnect = document.getElementById('spotify-connect') as HTMLAnchorElement;
	const spotifyDisconnect = document.getElementById('spotify-disconnect') as HTMLButtonElement;

	function renderSpotifyStatus(status: SpotifyStatus) {
		if (status.connected) {
			spotifyStatusText.textContent = status.displayName
				? `Connected to Spotify as ${status.displayName}`
				: 'Connected to Spotify';
			spotifyConnect.hidden = true;
			spotifyDisconnect.hidden = false;
		} else {
			spotifyStatusText.textContent = 'Not connected to Spotify';
			spotifyConnect.hidden = false;
			spotifyDisconnect.hidden = true;
		}
	}

	async function refreshSpotifyStatus() {
		try {
			const response = await fetch('/api/auth/status');
			const status = (await response.json()) as SpotifyStatus;
			renderSpotifyStatus(status);
		} catch {
			spotifyStatusText.textContent = 'Could not check Spotify status';
		}
	}

	spotifyDisconnect.addEventListener('click', async () => {
		spotifyDisconnect.disabled = true;
		try {
			await fetch('/api/auth/logout', { method: 'POST' });
		} finally {
			spotifyDisconnect.disabled = false;
			await refreshSpotifyStatus();
		}
	});

	const spotifyParam = new URLSearchParams(location.search).get('spotify');
	const spotifyRedirectMessages: Record<string, string> = {
		denied: 'Spotify connection was cancelled.',
		error: 'Something went wrong connecting to Spotify.',
	};
	if (spotifyParam) {
		history.replaceState(null, '', '/djme');
	}

	refreshSpotifyStatus().then(() => {
		if (spotifyParam && spotifyRedirectMessages[spotifyParam]) {
			spotifyStatusText.textContent = spotifyRedirectMessages[spotifyParam];
		}
	});

	document.addEventListener('visibilitychange', () => {
		if (document.visibilityState === 'visible') {
			refreshSpotifyStatus();
		}
	});
</script>

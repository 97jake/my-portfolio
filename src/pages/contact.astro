---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const pageDescription = "Get in touch about AI/ML pipelines, strategy, or software development.";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Contact | ${SITE_TITLE}`} description={pageDescription} />
	</head>
	<body>
		<Header />
		<main>
			<section class="cta-band">
				<h1>Have a project in mind?</h1>
				<p>Tell me what you're working on — I'd love to hear about it.</p>
				<a class="button button-inverse" href="mailto:97jake@gmail.com?subject=Consulting%20Inquiry"
					>Email Me</a
				>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
		max-width: 1080px;
		padding-top: 2em;
	}

	.cta-band {
		background: linear-gradient(135deg, var(--accent-purple), var(--accent), var(--accent-teal));
		color: white;
		text-align: center;
		border-radius: 16px;
		padding: 4em 2em;
		margin-bottom: 1em;
	}

	.cta-band h1 {
		margin-bottom: 0.4em;
	}

	.cta-band p {
		font-size: 1.1em;
		margin-bottom: 1.5em;
	}

	.button-inverse {
		display: inline-block;
		padding: 0.75em 1.5em;
		border-radius: 8px;
		font-weight: 700;
		text-decoration: none;
		background: white;
		color: var(--accent-dark);
		transition:
			background-color 0.2s ease,
			color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.button-inverse:hover {
		background: rgb(var(--gray-light));
		color: var(--accent-dark);
	}

	@media (max-width: 720px) {
		.cta-band {
			padding: 2.5em 1.5em;
		}
	}
</style>

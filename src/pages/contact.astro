---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const pageDescription = 'Get in touch about a website redesign or development project.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Contact | ${SITE_TITLE}`} description={pageDescription} />
	</head>
	<body>
		<Header />
		<main>
			<section class="contact-hero">
				<p class="eyebrow">Contact</p>
				<h1>Have a project in mind?</h1>
				<p class="sub">Tell me what you're working on — I'd love to hear about it.</p>
				<a class="cta-primary" href="mailto:97jake@gmail.com?subject=Consulting%20Inquiry"
					>Email me</a
				>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
		max-width: 1080px;
		padding-top: 2em;
	}
	.contact-hero {
		padding: 3em 1em 4em;
	}
	.eyebrow {
		margin: 0 0 14px;
		font-size: 12px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent);
		font-weight: 700;
	}
	h1 {
		margin: 0 0 18px;
		font-weight: 700;
		font-size: clamp(32px, 6vw, 52px);
		line-height: 1.04;
		letter-spacing: -0.025em;
		color: rgb(var(--ink));
	}
	.sub {
		margin: 0 0 26px;
		font-size: 16px;
		line-height: 1.55;
		color: rgb(var(--ink-2));
		max-width: 46ch;
	}
	.cta-primary {
		display: inline-flex;
		align-items: center;
		min-height: 46px;
		padding: 0 22px;
		border-radius: 999px;
		font-size: 15px;
		font-weight: 700;
		text-decoration: none;
		background: rgb(var(--ink));
		color: #fbf8f3;
	}
	.cta-primary:hover {
		background: var(--accent);
		color: #fbf8f3;
	}
</style>
